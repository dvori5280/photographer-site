# העתיקי קובץ זה לשם .env והחליפי את הערכים. אסור להעלות את .env ל-GitHub.

# כתובת החיבור למסד PostgreSQL
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DBNAME?schema=public"

# מפתח סודי לחתימת טוקנים. מחרוזת אקראית באורך 32 תווים לפחות.
# ליצירה: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=""

# תוקף הטוקן (ברירת מחדל 7 ימים)
JWT_EXPIRES_IN="7d"

# כתובות ה-React שמותר להן לפנות לשרת, מופרדות בפסיק. אפשר * לפיתוח בלבד.
CORS_ORIGINS="http://localhost:5173,http://localhost:3000"

PORT=3000
NODE_ENV="development"

# הגבלת בקשות
CONTACT_RATE_LIMIT_MAX=5
CONTACT_RATE_LIMIT_WINDOW_MINUTES=60
AUTH_RATE_LIMIT_MAX=30
AUTH_RATE_LIMIT_WINDOW_MINUTES=15

# נתוני פתיחה (Seed)
# פרטי המנהלת. חובה בפרודקשן.
SEED_ADMIN_EMAIL="admin@example.com"
SEED_ADMIN_PASSWORD=""
SEED_ADMIN_NAME="מנהלת האתר"
# true = ליצור גם קטגוריות, תמונות, חבילות ולקוחה לדוגמה
SEED_DEMO_DATA="true"
# סיסמת הלקוחה לדוגמה. בפרודקשן חובה להגדיר, אחרת הלקוחה לא תיווצר.
SEED_DEMO_CUSTOMER_PASSWORD=""
